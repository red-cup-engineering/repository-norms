{
  "name": "@red-cup-engineering/repository-norms",
  "version": "0.1.0",
  "description": "The 561 Group's repository norms as checks: section naming, submodule integrity, and evidence-bound first-visit README observations.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "repository-norms": "./bin/repository-norms.mjs"
  },
  "exports": {
    "./naming": "./src/naming.mjs",
    "./submodules": "./src/submodules.mjs",
    "./norms.json": "./norms.json",
    "./frontdoor": "./src/frontdoor.mjs",
    "./package-surface": "./src/package-surface.mjs",
    "./layout": "./src/layout.mjs"
  },
  "files": [
    "bin",
    "src",
    "norms.json",
    "README.md"
  ],
  "scripts": {
    "check": "node bin/repository-norms.mjs check .",
    "test": "NODE_OPTIONS=\"--experimental-import-meta-resolve --import=$LAGOON_WORKSPACE/services/engineering-services-section/services/computer-engineering-services-section/services/computer-systems-engineering-services-section/services/computer-operating-systems-engineering-services-section/services/computer-distributed-operating-systems-engineering-services-section/apps/lagoon/src/resolve-checkouts.mjs\" node --test test/*.test.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/red-cup-engineering/repository-norms.git"
  },
  "funding": {
    "type": "individual",
    "url": "https://github.com/561-group/.github/blob/main/TIPS.md"
  },
  "dependencies": {
    "@red-cup-engineering/git-engine": "^0.1.11-dev.0"
  }
}
